# Required: from @BotFather
BOT_TOKEN=123456789:ABCDEF_your_bot_token

# Required: comma-separated Telegram user IDs (get yours from @userinfobot)
ADMIN_IDS=123456789

# Optional: shared inbox group/supergroup chat ID (negative number).
# If set, user messages are delivered there instead of each admin's DM.
# Disable privacy mode in BotFather (/setprivacy -> Disable) when using a group inbox.
# ADMIN_CHAT_ID=-1001234567890

# Optional: enable Topics in a forum supergroup inbox (one topic per user).
# The group must have Topics enabled; the bot needs can_manage_topics.

# Webhook (optional). If WEBHOOK_URL is set, the bot uses webhook instead of polling.
# Put a reverse proxy (Caddy/Nginx/Cloudflare Tunnel) in front for TLS.
# WEBHOOK_URL=https://bot.example.com/telegram
# WEBHOOK_LISTEN=0.0.0.0
# WEBHOOK_BIND=127.0.0.1
# WEBHOOK_PORT=8080
# WEBHOOK_PATH=/telegram
# Required with WEBHOOK_URL: 32-256 characters (A-Z, a-z, 0-9, _ and -).
# WEBHOOK_SECRET=replace_with_at_least_32_random_characters

# Cloudflare Turnstile (optional; configure all three values together).
# Reverse-proxy this HTTPS origin to the challenge listener below.
# CHALLENGE_PUBLIC_URL=https://challenge.example.com
# TURNSTILE_SITEKEY=0x4AAAAAA_your_public_sitekey
# TURNSTILE_VERIFY_URL=https://turnstile-siteverify-example.workers.dev
# CHALLENGE_LISTEN=0.0.0.0
# CHALLENGE_BIND=127.0.0.1
# CHALLENGE_PORT=8081

# Optional
# DATABASE_PATH=data/bot.db
# TZ=Asia/Shanghai
# LOG_LEVEL=INFO
# MAX_CONCURRENT_UPDATES=16
# UPDATE_QUEUE_SIZE=256
# WEBHOOK_MAX_CONNECTIONS=10
# Set to 0 to disable the process-wide inbound budget.
# GLOBAL_RATE_LIMIT_COUNT=120
# GLOBAL_RATE_LIMIT_WINDOW=60
# MESSAGE_MAP_RETENTION_DAYS=90
# BOT_IMAGE=ghcr.io/yayitinyu/nanami-chat-bot@sha256:...
