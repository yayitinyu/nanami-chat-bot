# Required: from @BotFather
BOT_TOKEN=123456789:ABCDEF_your_bot_token

# Required: comma-separated Telegram user IDs (get yours from @userinfobot)
ADMIN_IDS=123456789

# Optional: shared inbox group/supergroup chat ID (negative number).
# If set, user messages are delivered there instead of each admin's DM.
# Disable privacy mode in BotFather (/setprivacy -> Disable) when using a group inbox.
# ADMIN_CHAT_ID=-1001234567890

# Optional: enable Topics in a forum supergroup inbox (one topic per user).
# The group must have Topics enabled; the bot needs can_manage_topics.

# Webhook (optional). If WEBHOOK_URL is set, the bot uses webhook instead of polling.
# Put a reverse proxy (Caddy/Nginx/Cloudflare Tunnel) in front for TLS.
# WEBHOOK_URL=https://bot.example.com/telegram
# WEBHOOK_LISTEN=0.0.0.0
# WEBHOOK_PORT=8080
# WEBHOOK_PATH=/telegram
# WEBHOOK_SECRET=change-me-long-random

# Optional
# DATABASE_PATH=data/bot.db
# TZ=Asia/Shanghai
# LOG_LEVEL=INFO
